# ElektroPlan - Beispielkonfiguration. Kopieren nach .env und Werte anpassen.
# KEINE echten Secrets in dieses Repository committen.

ELEKTROPLAN_ENVIRONMENT=development
ELEKTROPLAN_DEBUG=true

# --- Datenbank ---
ELEKTROPLAN_DATABASE_URL=postgresql+psycopg://elektroplan:elektroplan@localhost:5432/elektroplan

# --- Sicherheit ---
# Erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(64))"
ELEKTROPLAN_JWT_SECRET=bitte-ersetzen-mindestens-32-zeichen-langer-zufallswert
ELEKTROPLAN_JWT_KEY_ID=key-1
ELEKTROPLAN_ACCESS_TOKEN_MINUTES=15
ELEKTROPLAN_REFRESH_TOKEN_DAYS=14

# --- Object Storage (S3 / MinIO) ---
ELEKTROPLAN_S3_ENDPOINT_URL=http://localhost:9000
ELEKTROPLAN_S3_ACCESS_KEY=elektroplan
ELEKTROPLAN_S3_SECRET_KEY=elektroplan-dev-secret
ELEKTROPLAN_S3_BUCKET=elektroplan
ELEKTROPLAN_S3_REGION=eu-central-1

# --- CORS ---
ELEKTROPLAN_CORS_ORIGINS=http://localhost:5173

# --- Seed (nur Entwicklung) ---
ELEKTROPLAN_SEED_ORG_NAME=Elektro Musterbetrieb GmbH
ELEKTROPLAN_SEED_ADMIN_EMAIL=admin@example.com
ELEKTROPLAN_SEED_ADMIN_PASSWORD=aendere-dieses-passwort
