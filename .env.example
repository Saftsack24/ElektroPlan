# ElektroPlan - Beispielkonfiguration fuer die ENTWICKLUNG.
# Kopieren nach .env und Werte anpassen. KEINE echten Secrets in dieses
# Repository committen; .env ist ignoriert.
#
# Zwei Verwendungen derselben Datei:
#
# 1. docker compose liest .env im Projektverzeichnis und setzt nur die
#    Variablen ein, die docker-compose.yml mit ${...} nennt (Abschnitt A).
#    Alle anderen Zeilen erreichen die Container NICHT.
#    Achtung: Eine gleichnamige Variable der aufrufenden Shell hat Vorrang
#    vor dieser Datei.
# 2. Werkzeuge direkt auf dem Rechner (tasks.ps1, alembic, app.cli) lesen
#    ihre Werte aus der Umgebung bzw. aus apps/backend/.env (Abschnitt B).
#
# Alle hier eingetragenen Werte sind ENTWICKLUNGSWERTE. In Produktion
# (ELEKTROPLAN_ENVIRONMENT=production) verweigert das Backend den Start mit
# ihnen. Eine Produktionskonfiguration ist ein eigener, noch offener
# Freigabepunkt (docs/security.md, Abschnitt 8).

# =====================================================================
# A) Wird von docker compose an die Container durchgereicht
# =====================================================================

# --- JWT-Signaturschluessel ---
# Leer = das Backend nutzt einen oeffentlich bekannten Entwicklungsersatzwert
# und protokolliert beim Start die Warnung "jwt_secret_development_default".
# Eigenen Wert erzeugen (wird nicht ausgegeben, wenn man ihn direkt in .env
# schreibt):  python -c "import secrets; print(secrets.token_urlsafe(64))"
ELEKTROPLAN_JWT_SECRET=
ELEKTROPLAN_JWT_KEY_ID=key-1

# --- Object Storage (MinIO) ---
# Gilt fuer MinIO selbst UND das Backend. Bei einem bereits angelegten
# MinIO-Volume nur bewusst aendern.
ELEKTROPLAN_S3_SECRET_KEY=elektroplan-dev-secret

# --- Startbestand (nur Entwicklung, `python -m app.cli seed`) ---
# Wirkt nur beim Anlegen; ein bestehendes Konto behaelt sein Passwort.
ELEKTROPLAN_SEED_ORG_NAME=Elektro Musterbetrieb GmbH
ELEKTROPLAN_SEED_ADMIN_EMAIL=admin@example.com
ELEKTROPLAN_SEED_ADMIN_PASSWORD=entwicklung-bitte-aendern

# =====================================================================
# B) Nur fuer den Start ohne Docker (Backend direkt auf dem Rechner)
#    In docker compose stehen diese Werte fest in docker-compose.yml.
# =====================================================================

ELEKTROPLAN_ENVIRONMENT=development
ELEKTROPLAN_DEBUG=true

# --- Datenbank ---
# Entwicklungs-Zugangsdaten des Compose-Volumes. Das Kennwort wird nur beim
# ersten Anlegen des Volumes gesetzt und hier deshalb nicht geaendert.
# 127.0.0.1 statt localhost: Compose bindet nur IPv4-Loopback; localhost loest unter
# Windows zuerst ::1 auf, und die Verbindung wartet dort bis zum Timeout.
ELEKTROPLAN_DATABASE_URL=postgresql+psycopg://elektroplan:elektroplan@127.0.0.1:5432/elektroplan

# --- Sitzungen ---
ELEKTROPLAN_ACCESS_TOKEN_MINUTES=15
ELEKTROPLAN_REFRESH_TOKEN_DAYS=14

# --- Object Storage ---
ELEKTROPLAN_S3_ENDPOINT_URL=http://127.0.0.1:9000
ELEKTROPLAN_S3_ACCESS_KEY=elektroplan
ELEKTROPLAN_S3_BUCKET=elektroplan
ELEKTROPLAN_S3_REGION=eu-central-1

# --- Einladungen (Phase 4.2) ---
# none: kein Zustellweg -> Einladungen werden abgelehnt (Produktion, bis ein
#       E-Mail-Versand existiert). development_link: Link erscheint einmalig in
#       der Oberflaeche - NUR Entwicklung, in Produktion verweigert der Start.
ELEKTROPLAN_INVITATION_DELIVERY=development_link
ELEKTROPLAN_INVITATION_VALID_HOURS=72
ELEKTROPLAN_PUBLIC_APP_URL=http://localhost:5173

# --- Passwortzuruecksetzung (Phase 4e) ---
# none: kein Zustellweg -> ein Reset wird abgelehnt. admin_link: Der einmalige
#       Link erscheint genau einmal beim ausloesenden Administrator - NUR
#       ausserhalb der Produktion, in Produktion verweigert der Start.
ELEKTROPLAN_PASSWORD_RESET_DELIVERY=admin_link
ELEKTROPLAN_PASSWORD_RESET_VALID_MINUTES=60

# --- CORS ---
ELEKTROPLAN_CORS_ORIGINS=http://localhost:5173
